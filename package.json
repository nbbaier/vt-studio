{
  "name": "@outerbase/studio",
  "version": "0.10.2",
  "description": "A modern, browser-based SQLite database GUI purpose-built for Val Town",
  "keywords": [
    "valtown",
    "sqlite",
    "database",
    "gui",
    "studio",
    "sql-editor",
    "browser-database"
  ],
  "private": false,
  "scripts": {
    "dev": "next dev -p 3008",
    "dev-https": "next dev --experimental-https",
    "start": "next start",
    "build": "next build",
    "tsc": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "staged": "bun run typecheck && bun run lint && bun run test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome lint --check .",
    "check:fix": "biome lint --check --write .",
    "dialect": "node build-dialect.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
